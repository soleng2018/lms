        "instructions": [
          {
            "type": "text",
            "content": "Navigate to Network Setup → Wireless.",
            "bold_text": ["Network Setup → Wireless"],
            "code_text": []
          },
          {
            "type": "text",
            "content": "Click on the ➕ icon to add a new SSID.",
            "bold_text": [],
            "code_text": []
          },
          {
            "type": "sub_steps",
            "content": "Configure the following:",
            "sub_steps": [
              "SSID Name: Define anything you like, ensure it is unique to you. e.g, Alonso-PSK (Alonso is my tenant name)",
              "Type: Personal",
              "Security: WPA2",
              "Pre-shared key: 12345678",
              "Segment : PSK-Seg (or any other name you may have used)"
            ]
          }
        ],
        "example_box": {
