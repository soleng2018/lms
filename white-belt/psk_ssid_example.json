  "task_instructions": {
    "steps": [
      {
        "step_number": 1,
        "title": "DHCP Configuration",
        "instructions": [
          {
            "type": "text",
            "content": "Navigate to Network Setup → DHCP.",
            "bold_text": ["Network Setup → DHCP"],
            "code_text": []
          },
          {
            "type": "text",
            "content": "Select Nile DHCP as the server type.",
            "bold_text": [],
            "code_text": ["Nile DHCP"]
          },
          {
            "type": "sub_steps",
            "content": "Create a new DHCP scope for this PSK SSID:",
            "sub_steps": [
              "Pool Name - PSK-Scope",
              "Network - 192.168.10.0/24",
              "DNS Server - 4.2.2.1",
              "Click Save"
            ]
          }
        ],
        "example_box": {
          "enabled": false,
          "content": ""
        },
        "note_box": {
          "enabled": false,
          "content": ""
        },
        "warning_box": {
          "enabled": false,
          "content": ""
        }
      },
      {
        "step_number": 2,
        "title": "Segment Creation",
        "instructions": [
          {
            "type": "text",
            "content": "Go to Network Setup → Segments.",
            "bold_text": ["Network Setup → Segments"],
            "code_text": []
          },
          {
            "type": "sub_steps",
            "content": "Create a new segment named PSK-Seg:",
            "sub_steps": [
              "Select the Service Area.",
              "Choose HoL and Click OK",
              "No Authentication source needs to be configured",
              "Select the DHCP scope (Nile DHCP) for the clients.",
              "Select the Subnet PSK-Scope that was created in the previous Step",
              "Click Save"
            ]
          }
        ],
        "example_box": {
          "enabled": false,
          "content": ""
        },
        "note_box": {
          "enabled": false,
          "content": ""
        },
        "warning_box": {
